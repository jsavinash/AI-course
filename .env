# Environment configuration for mlops-monorepo
# Generated from source: keys read via os.getenv / ai_core.config (MLOPS_ prefix).
# Values are the in-code defaults. Override per environment (dev/staging/prod).
# Secrets (LLM provider keys) are left blank/commented.


# ---- Core serving & security ----
# API_KEY=
CORS_ORIGINS=*
DRIFT_THRESHOLD=0.2
# FASTAPI_ENV=
FORWARDED_ALLOW_IPS=127.0.0.1,::1
LOG_LEVEL=INFO
# MAX_REQUEST_SIZE_BYTES=
MODEL_DIR=./artifacts/models
MODEL_ID=text-generation-v1
MODEL_VERSION=1.0.0
RATE_LIMIT_PER_MINUTE=0
REGISTER_MLFLOW=false
# VALIDATE_ONLY=
VALIDATE_TRAIN_TIMEOUT=180
# WEB_CONCURRENCY=

# ---- MLflow tracking & MLOPS config ----
# ai_core Config uses MLOPS_ prefix (packages/ai-core/src/ai_core/config.py)
# MLFLOW_TRACKING_URI=
MLOPS_ENVIRONMENT=development
MLOPS_MODEL_NAME=default
MLOPS_MODEL_VERSION=1.0.0
MLOPS_MLFLOW_TRACKING_URI=http://mlflow:5000
MLOPS_MLFLOW_REGISTRY_URI=http://mlflow:5000
MLOPS_MLFLOW_EXPERIMENT_NAME=mlops
MLOPS_MLFLOW_ARTIFACT_ROOT=./mlflow/artifacts
MLOPS_REGISTRY_BASE_DIR=./models
MLOPS_REGISTRY_DEFAULT_STATUS=staging
MLOPS_REGISTRY_MAX_VERSIONS=5
MLOPS_REGISTRY_AUTO_PROMOTE=false
MLOPS_REGISTRY_PROMOTION_THRESHOLD=0.9
MLOPS_MONITORING_METRICS_PORT=8000
MLOPS_MONITORING_ENABLE_PROMETHEUS=true
MLOPS_MONITORING_DRIFT_THRESHOLD=0.2
MLOPS_MONITORING_DRIFT_CHECK_INTERVAL=100
MLOPS_MONITORING_LOG_LEVEL=INFO
MLOPS_MONITORING_ENABLE_REQUEST_LOGGING=true
MLOPS_DATA_VALIDATION_ENABLED=true
MLOPS_DATA_CACHE_ENABLED=true
MLOPS_DATA_CACHE_DIR=./tmp/mlops-cache

# ---- Common training hyperparameters ----
# shared defaults across training scripts
HIDDEN_DIM=32
HIDDEN_DIMS=16,8
IMG_SIZE=32
KERNEL_SIZE=3
LATENT_DIM=64
LEARNING_RATE=0.05
MAX_SEQ_LEN=32
NUM_HEADS=4
N_CLASSES=10
N_CLUSTERS=5
N_COMPONENTS=0.95
N_DIFFUSION_STEPS=1000
# N_DOCS=
N_EPOCHS=100
# N_FEATURES=
N_FILTERS=8
N_FRAMES=8
N_HEADS=4
N_HIDDEN=16
N_INIT=10
N_ITERATIONS=300
N_LAYERS=2
N_NODES=20
# N_PIXELS=
N_SAMPLES=500
N_TIMESTEPS=10
N_TOOLS=5
RANDOM_SEED=42
SEQ_LEN=32
TEST_SIZE=0.2
TIMESTEPS=100
# VOCAB_SIZE=
WEIGHT_DECAY=0.001

# ---- App-specific hyperparameters ----
# per-app model/algorithm tuning
ALPHA=0.01
ATTENTION_TYPE=multi_head
AUDIO_ENCODER_DIM=80
BASE_MODEL_NAME=default
BETA_END=0.02
BETA_START=0.0001
# CAPTION_LEN=
CHAT_APP_PORT=3000
# CHAT_PROXY_ALLOWED_EXACT_PATHS=
# CHAT_PROXY_ALLOWED_PATH_PREFIXES=
CHAT_PROXY_TIMEOUT_SECONDS=300.0
# CHUNK_SIZE=
CONFIDENCE_THRESHOLD=0.95
CONNECTOR_DIM=512
DISCOUNT_FACTOR=0.99
D_FF=512
D_MODEL=128
EPSILON_DECAY=0.995
FINE_TUNE_LAYERS=0
FINE_TUNE_LR=0.0001
FREEZE_BASE=true
FUSION_TYPE=hybrid
GRID_HEIGHT=5
GRID_WIDTH=5
IMAGE_ENCODER_DIM=768
LABELED_RATIO=0.1
LEAK_RATE=0.9
MAX_ITEMSET_SIZE=4
MAX_ITERATIONS=300
MAX_STEPS=200
MAZE_SIZE=8
# METRICS_PORT=
MIN_CONFIDENCE=0.5
MIN_LIFT=1.0
MIN_SUPPORT=0.05
# MYPYPATH=
NOISE_LEVEL=0.3
NOISE_RATE=0.0
N_BASE_LAYERS=2
N_CD_STEPS=1
N_DECODER_LAYERS=2
N_ENCODER_LAYERS=2
N_EPISODES=500
OBJECTIVE=ntp
# OVERLAP=
PANSEQ=0
PHASE=pretrain
RL_MODE=online
SIGMA=2.0
SPAM_THRESHOLD=0.5
STRATEGY=full
TECHNIQUE=zero-shot
TEXT_ENCODER_DIM=256
THRESHOLD=1.0
THRESHOLD_IQR_MULTIPLIER=1.5
THRESHOLD_METHOD=percentile
THRESHOLD_PERCENTILE=95.0
TOP_K=50
TOP_P=0.9

