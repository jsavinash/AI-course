"""K-Means clustering model for market segmentation.

Implements a production-ready K-Means from scratch:
- K-Means++ initialization for robust centroid seeding
- Lloyd's algorithm (E-step assignment + M-step update)
- Feature standardization with saved mean/std for inference
- Inertia (WCSS) and Silhouette score for model evaluation
- Proper serialization with metadata (.npz)
"""

from dataclasses import dataclass, field

import numpy as np

from market_segmentation.data import FEATURE_NAMES


@dataclass
class KMeans:
    """K-Means clustering for unsupervised customer segmentation.

    Uses Euclidean distance after standardizing features, so each feature
    contributes equally to the cluster assignment.
    """

    n_clusters: int = 5
    max_iterations: int = 300
    tolerance: float = 1e-4
    random_seed: int = 42
    n_init: int = 10
    # Fitted parameters
    centroids: np.ndarray | None = None  # Shape (n_clusters, n_features) in standardized space
    feature_mean: np.ndarray | None = None  # Mean of each feature from training
    feature_std: np.ndarray | None = None  # Std of each feature from training
    labels: np.ndarray | None = None  # Cluster assignment for training data
    inertia: float = 0.0  # WCSS - within-cluster sum of squared distances
    n_iterations_used: int = 0
    silhouette: float = -1.0  # Mean silhouette score (-1 to 1)
    iteration_history: list[float] = field(default_factory=list)  # Inertia per iteration

    # ---------- Preprocessing ----------

    def _standardize(self, X: np.ndarray) -> np.ndarray:
        """Standardize features to zero mean and unit variance using fitted stats."""
        if self.feature_mean is None or self.feature_std is None:
            raise ValueError("Model not fitted. Call fit() first.")
        return (X - self.feature_mean) / self.feature_std

    def _fit_standardizer(self, X: np.ndarray) -> None:
        """Compute and store feature mean/std from the training data."""
        self.feature_mean = np.mean(X, axis=0)
        self.feature_std = np.std(X, axis=0)
        self.feature_std[self.feature_std == 0] = 1.0  # Avoid division by zero

    # ---------- K-Means++ initialization ----------

    def _init_centroids_kmeans_plus_plus(
        self, X: np.ndarray, rng: np.random.Generator
    ) -> np.ndarray:
        """Initialize centroids using the K-Means++ algorithm.

        Selects the first centroid uniformly at random, then each subsequent
        centroid is chosen with probability proportional to the squared
        distance to the nearest existing centroid. This dramatically improves
        convergence and final clustering quality versus random initialization.
        """
        n_samples, _ = X.shape
        centroids = np.zeros((self.n_clusters, X.shape[1]))

        # 1st centroid: uniform random sample
        first_idx = rng.integers(0, n_samples)
        centroids[0] = X[first_idx]

        # Remaining centroids
        for k in range(1, self.n_clusters):
            # Distance from each point to its nearest centroid
            dists = self._assign_clusters(X, centroids[:k])[1]
            min_dists = dists.min(axis=1)
            min_dists = min_dists**2  # Square for probability weighting

            # Guard against all-zero (duplicate points)
            total = min_dists.sum()
            if total == 0:
                idx = rng.integers(0, n_samples)
            else:
                probs = min_dists / total
                idx = rng.choice(n_samples, p=probs)
            centroids[k] = X[idx]

        return centroids

    # ---------- Core K-Means ----------

    def _assign_clusters(
        self, X: np.ndarray, centroids: np.ndarray
    ) -> tuple[np.ndarray, np.ndarray]:
        """E-step: assign each point to the nearest centroid.

        Returns:
            labels: array of cluster indices for each sample
            distances: pairwise squared distances (n_samples, n_clusters)
        """
        # Pairwise Euclidean distance: ||x - c||² = ||x||² - 2x·c + ||c||²
        x2 = np.sum(X**2, axis=1, keepdims=True)
        c2 = np.sum(centroids**2, axis=1)
        distances = x2 - 2 * np.dot(X, centroids.T) + c2
        distances = np.maximum(distances, 0)  # Numerical safety

        labels = np.argmin(distances, axis=1)
        return labels, distances

    def _update_centroids(
        self, X: np.ndarray, labels: np.ndarray, n_clusters: int
    ) -> np.ndarray:
        """M-step: recompute centroids as the mean of points in each cluster."""
        centroids = np.zeros((n_clusters, X.shape[1]))
        for k in range(n_clusters):
            mask = labels == k
            if np.any(mask):
                centroids[k] = np.mean(X[mask], axis=0)
            else:
                # Empty cluster - keep previous centroid value
                pass
        return centroids

    def _compute_inertia(self, X: np.ndarray, labels: np.ndarray, centroids: np.ndarray) -> float:
        """Compute WCSS: sum of squared distances to assigned centroids."""
        _, distances = self._assign_clusters(X, centroids)
        inertia = float(np.sum(distances[np.arange(len(X)), labels]))
        return inertia

    def _run_single_init(
        self, X: np.ndarray, rng: np.random.Generator
    ) -> tuple[np.ndarray, np.ndarray, float, int, list[float]]:
        """Run K-Means from one initialization. Returns (centroids, labels, inertia, its, history)."""
        centroids = self._init_centroids_kmeans_plus_plus(X, rng)
        labels = np.zeros(len(X), dtype=int)
        history: list[float] = []

        for iteration in range(self.max_iterations):
            new_labels, _ = self._assign_clusters(X, centroids)
            new_centroids = self._update_centroids(X, new_labels, self.n_clusters)

            inertia = self._compute_inertia(X, new_labels, new_centroids)
            history.append(inertia)

            # Check convergence: centroid shift below tolerance
            shift = np.linalg.norm(new_centroids - centroids)
            if shift < self.tolerance and iteration > 0:
                labels = new_labels
                centroids = new_centroids
                break

            labels = new_labels
            centroids = new_centroids

        inertia = self._compute_inertia(X, labels, centroids)
        return centroids, labels, inertia, iteration + 1, history

    def fit(self, X: np.ndarray) -> "KMeans":
        """Train K-Means clustering on the input data.

        Runs n_init independent restarts (K-Means++) and keeps the solution
        with the lowest inertia (WCSS).

        Note: This is unsupervised - no labels are required or used.
        """
        if X.ndim == 1:
            X = X.reshape(-1, 1)
        if len(X) < self.n_clusters:
            raise ValueError(
                f"Number of clusters ({self.n_clusters}) exceeds number of samples ({len(X)})"
            )

        # Standardize features
        self._fit_standardizer(X)
        X_norm = self._standardize(X)

        best_inertia = np.inf
        best_centroids: np.ndarray | None = None
        best_labels: np.ndarray | None = None
        best_iterations = 0
        best_history: list[float] = []

        for init_idx in range(self.n_init):
            rng = np.random.default_rng(self.random_seed + init_idx)
            centroids, labels, inertia, n_iters, history = self._run_single_init(X_norm, rng)

            if inertia < best_inertia:
                best_inertia = inertia
                best_centroids = centroids
                best_labels = labels
                best_iterations = n_iters
                best_history = history

        assert best_centroids is not None and best_labels is not None

        self.centroids = best_centroids
        self.labels = best_labels
        self.inertia = best_inertia
        self.n_iterations_used = best_iterations
        self.iteration_history = best_history

        # Compute silhouette score based on clustering structure itself.
        self.silhouette = self.silhouette_score(X_norm)

        return self

    # ---------- Prediction ----------

    def predict(self, X: np.ndarray) -> np.ndarray:
        """Assign each sample to the nearest cluster.

        Unsupervised: returns cluster index in [0, n_clusters) for each point.
        """
        if self.centroids is None:
            raise ValueError("Model not trained. Call fit() first.")
        if X.ndim == 1:
            X = X.reshape(1, -1)

        X_norm = self._standardize(X)
        labels, _ = self._assign_clusters(X_norm, self.centroids)
        return labels

    def predict_distances(self, X: np.ndarray) -> np.ndarray:
        """Return distance to every centroid for each sample (for confidence scoring)."""
        if self.centroids is None:
            raise ValueError("Model not trained. Call fit() first.")
        if X.ndim == 1:
            X = X.reshape(1, -1)

        X_norm = self._standardize(X)
        _, distances = self._assign_clusters(X_norm, self.centroids)
        return distances

    def predict_confidence(self, X: np.ndarray) -> np.ndarray:
        """Return a confidence-like score in [0, 1] for each prediction.

        Confidence = ratio of distance to the *second* closest centroid over
        distance to the closest. Higher values (closer to 1) mean the point
        is close to one centroid and far from all others -> high confidence.
        """
        distances = self.predict_distances(X)
        sorted_dists = np.sort(distances, axis=1)
        best = sorted_dists[:, 0]
        second = sorted_dists[:, 1]
        confidence = second / (best + second + 1e-9)
        return confidence

    # ---------- Evaluation metrics (unsupervised) ----------

    def silhouette_score(self, X_norm: np.ndarray | None = None) -> float:
        """Compute mean silhouette coefficient over the training data.

        Silhouette ranges from -1 to 1:
        - 1: well-separated, compact clusters
        - 0: overlapping clusters
        - -1: poor clustering

        Uses the standardized feature space and current cluster labels.
        """
        if self.centroids is None or self.labels is None:
            raise ValueError("Model not trained. Call fit() first.")

        if X_norm is None:
            raise ValueError("X_norm is required for silhouette computation")

        n_samples = len(X_norm)
        labels = self.labels

        if n_samples < 2 or len(np.unique(labels)) < 2:
            return 0.0

        # Precompute pairwise squared distances
        x2 = np.sum(X_norm**2, axis=1, keepdims=True)
        d2 = x2 - 2 * np.dot(X_norm, X_norm.T) + x2.T
        d2 = np.maximum(d2, 0)  # Numerical safety

        silhouette_values = np.zeros(n_samples)
        for i in range(n_samples):
            same_cluster = labels == labels[i]
            same_cluster[i] = False
            other_clusters = np.unique(labels[labels != labels[i]])

            if not np.any(same_cluster):
                continue

            a_i = np.mean(np.sqrt(d2[i, same_cluster]))  # Mean intra-cluster distance

            b_i = np.inf
            for c in other_clusters:
                mask = labels == c
                mean_dist = np.mean(np.sqrt(d2[i, mask]))
                b_i = min(b_i, mean_dist)  # Mean distance to nearest other cluster

            denom = max(a_i, b_i)
            if denom == 0:
                silhouette_values[i] = 0.0
            else:
                silhouette_values[i] = (b_i - a_i) / denom

        # Filter out points whose silhouette was never computed
        valid = (
            silhouette_values[silhouette_values != 0.0]
            if np.any(silhouette_values != 0.0)
            else silhouette_values
        )
        if len(valid) == 0:
            return 0.0
        return float(np.mean(valid))

    def evaluate(self, X: np.ndarray) -> dict[str, float]:
        """Compute unsupervised evaluation metrics for the clustering.

        Args:
            X: Original (unstandardized) feature data used for training.
        """
        if self.centroids is None:
            raise ValueError("Model not trained. Call fit() first.")

        X_norm = self._standardize(X)
        labels = self.predict(X_norm)

        # Inertia (WCSS)
        inertia = self._compute_inertia(X_norm, labels, self.centroids)

        # Silhouette score
        silhouette = self.silhouette

        # Average distance to assigned centroid (mean intra-cluster spread)
        _, distances = self._assign_clusters(X_norm, self.centroids)
        assigned_dists = distances[np.arange(len(X_norm)), labels]
        mean_intra_cluster_distance = float(np.mean(np.sqrt(assigned_dists)))

        return {
            "inertia": inertia,
            "silhouette": silhouette,
            "mean_intra_cluster_distance": mean_intra_cluster_distance,
            "n_clusters": float(self.n_clusters),
            "n_samples": float(len(X)),
            "n_iterations": float(self.n_iterations_used),
        }

    def cluster_profiles(self, X: np.ndarray) -> list[dict]:
        """Return descriptive statistics for each cluster for business interpretation.

        Args:
            X: Original (unstandardized) feature data used for training.

        Returns:
            List of dicts with per-cluster: size, % of total, and mean feature values.
        """
        if self.centroids is None or self.labels is None:
            raise ValueError("Model not trained. Call fit() first.")

        labels = self.labels
        n_samples = len(X)
        profiles = []

        for k in range(self.n_clusters):
            mask = labels == k
            cluster_X = X[mask]
            n_size = int(np.sum(mask))
            pct = n_size / n_samples

            profile = {
                "cluster": k,
                "size": n_size,
                "share": round(pct, 4),
                "mean_features": {
                    name: round(float(np.mean(cluster_X[:, i])), 2)
                    for i, name in enumerate(FEATURE_NAMES)
                },
                "centroid": (
                    {
                        name: round(float(cent), 2)
                        for name, cent in zip(FEATURE_NAMES, self.centroids[k], strict=False)
                    }
                    if self.centroids is not None
                    else {}
                ),
            }
            profiles.append(profile)

        return profiles

    # ---------- Serialization ----------

    def save(self, path: str) -> None:
        """Save model parameters to disk (.npz)."""
        if self.centroids is None:
            raise ValueError("Cannot save untrained model")

        np.savez(
            path,
            centroids=self.centroids,
            feature_mean=self.feature_mean,
            feature_std=self.feature_std,
            labels=self.labels,
            inertia=self.inertia,
            silhouette=self.silhouette,
            n_clusters=self.n_clusters,
            max_iterations=self.max_iterations,
            tolerance=self.tolerance,
            random_seed=self.random_seed,
            n_init=self.n_init,
            n_iterations_used=self.n_iterations_used,
            iteration_history=np.array(self.iteration_history),
        )

    @classmethod
    def load(cls, path: str) -> "KMeans":
        """Load model parameters from disk."""
        data = np.load(path, allow_pickle=True)
        model = cls(
            n_clusters=int(data["n_clusters"]),
            max_iterations=int(data["max_iterations"]),
            tolerance=float(data["tolerance"]),
            random_seed=int(data["random_seed"]),
            n_init=int(data["n_init"]),
        )
        model.centroids = data["centroids"]
        model.feature_mean = data["feature_mean"]
        model.feature_std = data["feature_std"]
        model.labels = data["labels"]
        model.inertia = float(data["inertia"])
        model.silhouette = float(data["silhouette"])
        model.n_iterations_used = int(data["n_iterations_used"])
        model.iteration_history = list(data["iteration_history"])
        return model

    def to_dict(self) -> dict[str, float]:
        """Return hyperparameters as a dict."""
        return {
            "n_clusters": self.n_clusters,
            "max_iterations": self.max_iterations,
            "tolerance": self.tolerance,
            "n_init": self.n_init,
            "random_seed": self.random_seed,
        }